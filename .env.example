# ==========================================
# FabriLink Environment Configuration
# ==========================================

# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-fabrilink-dev-secret-key-change-in-production-2026
DEBUG=True
# 10.0.2.2 = the Android emulator's address for this machine (mobile app).
# Add your LAN IP too (e.g. 192.168.1.20) to test on a physical phone.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,10.0.2.2

# Database (PostgreSQL)
POSTGRES_DB=fabrilink_db
POSTGRES_USER=fabrilink_user
POSTGRES_PASSWORD=fabrilink_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://fabrilink_user:fabrilink_password@localhost:5432/fabrilink_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# SimpleJWT Token Lifetime
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Media & Storage (Local in dev / S3-compatible in prod)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Bangladeshi Payment Gateway Sandboxes
BKASH_SANDBOX_MODE=True
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password

NAGAD_SANDBOX_MODE=True
NAGAD_MERCHANT_ID=sandbox_merchant
NAGAD_PUBLIC_KEY=sandbox_public_key

SSLCOMMERZ_SANDBOX_MODE=True
SSLCOMMERZ_STORE_ID=fabri_sandbox
SSLCOMMERZ_STORE_PASS=fabri_sandbox@ssl

# SMS Provider (console mock by default)
SMS_PROVIDER=console
SMS_API_KEY=mock_key

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
