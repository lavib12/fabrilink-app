# Base URL of the FabriLink API (must end with /api/v1).
# Leave unset in development to use the platform default:
#   Android emulator -> http://10.0.2.2:8000/api/v1
#   iOS simulator / web -> http://localhost:8000/api/v1
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8000/api/v1
# (and add that IP to ALLOWED_HOSTS in the backend .env).
EXPO_PUBLIC_API_BASE_URL=
